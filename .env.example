# Put real secrets in PXXL's environment panel, not in source files.
BOT_TOKEN=
ADMIN_IDS=

# Required only for files larger than Telegram's Bot API download limit.
API_ID=
API_HASH=

# Python runtime downloads this model once into writable /tmp storage.
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=3
WHISPER_CPU_THREADS=2
WHISPER_ALLOW_RUNTIME_DOWNLOAD=1
HF_HOME=/tmp/hf_cache
HUGGINGFACE_HUB_CACHE=/tmp/hf_cache
MODEL_CACHE_DIR=/tmp/hf_cache

# Use a mounted volume instead of /tmp if persistence is available.
DATABASE_PATH=/tmp/subbot_db.json
TEMP_DIR=/tmp

MAX_FILE_SIZE_MB=400
MAX_VIDEO_DURATION=3600
DAILY_LIMIT_FREE=20
PORT=3000
EXPOSE_PORT=3000

FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
FONT_SIZE=28
MARGIN_V=40