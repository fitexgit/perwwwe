BOT_TOKEN=your_bot_token
ADMIN_IDS=123456789

# Required for files > 20MB (from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash

# Whisper — strong server recommendations:
#   small  = good balance (default)
#   medium = better accuracy, slower
#   base   = faster, less accurate
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# If you have NVIDIA GPU:
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en

MAX_FILE_SIZE_MB=400
DAILY_LIMIT_FREE=20
