# Secrets: enter these only in the PXXL environment-variable panel.
BOT_TOKEN=
ADMIN_IDS=

# Required only for files larger than the Telegram Bot API download limit.
API_ID=
API_HASH=

# The Dockerfile bakes the tiny model into the image by default.
# If changing this, rebuild the image with the same WHISPER_MODEL build argument.
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=3
WHISPER_CPU_THREADS=2
MODEL_CACHE_DIR=/app/models
WHISPER_ALLOW_RUNTIME_DOWNLOAD=0

# Free-tier-safe writable paths. Use a mounted volume for persistent data.
DATABASE_PATH=/tmp/subbot_db.json
TEMP_DIR=/tmp

MAX_FILE_SIZE_MB=400
MAX_VIDEO_DURATION=3600
DAILY_LIMIT_FREE=20
PORT=3000
EXPOSE_PORT=3000

FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
FONT_SIZE=28
MARGIN_V=40